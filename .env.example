# cp .env.example .env してから値を入れる。クォート不要・前後スペース禁止。
DISCORD_BOT_TOKEN=ここにトークン
WORK_LOG_CHANNEL_ID=0
PANEL_CHANNEL_ID=0
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ここにservice_roleキー
# 通信簿サイトのURL（未設定なら既定値が使われる）
WEB_APP_URL=https://minadeankinew.nibiroiro.workers.dev

# みんなで暗記！！(gakushu-rpg)連携：作業時間を通信簿/ランキングへ加算（空なら送信しない）
# Cloudflare側の `wrangler pages secret put VC_SECRET` と同じ値を入れる
GAKUSHU_VC_URL=https://gakushu-rpg.pages.dev/api/vc
GAKUSHU_VC_SECRET=
